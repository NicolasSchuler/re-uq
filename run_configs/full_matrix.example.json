{
  "run_group_id": "provider-matrix-v2-2026-05",
  "datasets": [
    "nice",
    "mlm_tapt"
  ],
  "benchmark_variants": [
    "must"
  ],
  "tasks": [
    "task1",
    "task2"
  ],
  "prompt_version": "v2-conf01",
  "deterministic": {
    "temperature": 0.0,
    "top_p": 1.0,
    "samples": 1
  },
  "stochastic": {
    "temperature": 0.7,
    "top_p": 1.0,
    "samples": 5
  },
  "logging": {
    "progress_every_records": 100,
    "progress_every_seconds": 60,
    "warn_after_records": 100,
    "warn_parse_failure_rate": 0.02,
    "warn_request_error_rate": 0.02,
    "write_progress_csv": true,
    "write_event_jsonl": true
  },
  "profiles": [
    {
      "profile_id": "local_llama_cpp",
      "provider_id": "llama_cpp",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key_env": "LOCAL_OPENAI_API_KEY",
      "models": [
        "qwen/qwen3.5-9b"
      ],
      "concurrency": 4,
      "batch_size": 4,
      "timeout_s": 120,
      "max_tokens": 256,
      "json_mode": false,
      "structured_output": "none",
      "requires_manual_server": true,
      "notes": "Start llama.cpp with exactly this model before running this profile."
    },
    {
      "profile_id": "institutional_llm",
      "provider_id": "institutional_llm",
      "base_url": "https://institutional-llm.example.invalid/api/v1",
      "api_key_env": "INSTITUTIONAL_LLM_API_KEY",
      "models": [
        "azure.gpt-4.1-mini"
      ],
      "concurrency": 2,
      "batch_size": 8,
      "timeout_s": 180,
      "max_tokens": 256,
      "json_mode": true,
      "structured_output": "json_schema",
      "requires_manual_server": false,
      "notes": "Coordinate large automated runs with the institutional LLM endpoint operator."
    },
    {
      "profile_id": "zai",
      "provider_id": "zai",
      "base_url": "https://api.z.ai/api/coding/paas/v4",
      "api_key_env": "ZAI_API_KEY",
      "models": [
        "glm-5.1",
        "glm-5-turbo",
        "glm-4.7"
      ],
      "concurrency": 2,
      "batch_size": 8,
      "timeout_s": 180,
      "max_tokens": 256,
      "json_mode": true,
      "structured_output": "json_object",
      "extra_body": {
        "thinking": {
          "type": "disabled"
        },
        "response_format": {
          "type": "json_object"
        }
      },
      "requires_manual_server": false,
      "notes": "GLM Coding Plan endpoint. Standard paid API users should switch this to https://api.z.ai/api/paas/v4."
    }
  ]
}
