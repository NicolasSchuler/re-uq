# Local pre-compaction backups of the raw store.
data/processed.pre-final-*/

# Local manuscript and assistant-orchestration scratch files. Promote a
# manuscript deliberately with `git add -f` only when publication packaging
# requires it.
/docs/paper_draft.*
/o.sh
/*.local.sh

# Local settings and run definitions.
config.json
run_configs/current_run*.json

data/raw/*
!data/raw/.gitkeep

