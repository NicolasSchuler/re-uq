{
  "//": [
    "This file is generated by pi-sandbox from .devcontainer/sandbox.json.",
    "Edit sandbox.json and re-run `pi-sandbox render`; direct edits are overwritten."
  ],
  "name": "re-uq-sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--pull"
    ]
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=/Users/nicolas/.pi/devcontainer/lib,target=/opt/pi-sandbox/lib,type=bind,readonly",
    "source=/Users/nicolas/.pi/devcontainer/container-bin,target=/opt/pi-sandbox/bin,type=bind,readonly",
    "source=/Users/nicolas/.pi/web-search.json,target=/seed/pi/web-search.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/AGENTS.md,target=/seed/pi/agent/AGENTS.md,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/APPEND_SYSTEM.md,target=/seed/pi/agent/APPEND_SYSTEM.md,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/auth.json,target=/seed/pi/agent/auth.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/hermes-memory-config.json,target=/seed/pi/agent/hermes-memory-config.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/mcp.json,target=/seed/pi/agent/mcp.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/models-store.json,target=/seed/pi/agent/models-store.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/settings.json,target=/seed/pi/agent/settings.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/subagents.json,target=/seed/pi/agent/subagents.json,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/agents,target=/seed/pi/agent/agents,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/bin,target=/seed/pi/agent/bin,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/extensions,target=/seed/pi/agent/extensions,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/integrations,target=/seed/pi/agent/integrations,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/lib,target=/seed/pi/agent/lib,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/prompts,target=/seed/pi/agent/prompts,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/skills,target=/seed/pi/agent/skills,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/templates,target=/seed/pi/agent/templates,type=bind,readonly",
    "source=/Users/nicolas/.pi/workflows,target=/seed/pi/workflows,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/pi-hermes-memory,target=/home/vscode/.pi/agent/pi-hermes-memory,type=bind",
    "source=/Users/nicolas/.pi/agent/projects-memory,target=/home/vscode/.pi/agent/projects-memory,type=bind",
    "source=/Users/nicolas/.omp/agent/config.yml,target=/seed/omp/agent/config.yml,type=bind,readonly",
    "source=/Users/nicolas/.pi/agent/prompts,target=/seed/omp/agent/prompts,type=bind,readonly",
    "source=re-uq-home,target=/home/vscode,type=volume",
    "source=re-uq-pi-state,target=/home/vscode/.pi,type=volume",
    "source=re-uq-omp-state,target=/home/vscode/.omp,type=volume",
    "source=re-uq-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=re-uq-uv-data,target=/home/vscode/.local/share/uv,type=volume",
    "source=re-uq-venv,target=/opt/venv,type=volume"
  ],
  "containerEnv": {
    "PI_SANDBOX_RE_UQ": "1",
    "PI_SANDBOX_CORE": "/opt/pi-sandbox",
    "PI_SANDBOX_NAME": "re-uq",
    "PI_SANDBOX_USER": "vscode",
    "PI_SANDBOX_PI_RUNTIME_ROOT": "/opt/pi-runtime",
    "PI_SANDBOX_PI_PACKAGE": "@earendil-works/pi-coding-agent@latest",
    "PI_SANDBOX_PI_REFRESH": "1",
    "PI_SANDBOX_PI_REFRESH_TIMEOUT": "120",
    "PI_SANDBOX_PI_UPDATE_EXTENSIONS": "1",
    "PI_SANDBOX_OMP": "1",
    "PI_SANDBOX_OMP_SEED_FILES": "agent/config.yml:agent/keybindings.yml:agent/models.yml",
    "PI_SANDBOX_OMP_SEED_DIRS": "agent/commands:agent/prompts:agent/themes:agent/tools",
    "PI_SANDBOX_OMP_REFRESH": "1",
    "PI_SANDBOX_OMP_REFRESH_TIMEOUT": "120",
    "PI_SANDBOX_OMP_UPDATE_PLUGINS": "0",
    "PI_SANDBOX_OMP_PLUGIN_MANIFEST": "/seed/omp/plugins/package.json",
    "PI_SANDBOX_OMP_BROKER": "1",
    "PI_SANDBOX_PI_TRUST": "always",
    "PI_SANDBOX_SEED_DIRS": "agent/agents:agent/bin:agent/extensions:agent/integrations:agent/lib:agent/prompts:agent/skills:agent/templates:agent/themes:workflows",
    "PI_SANDBOX_SHARE_PATHS": "agent/pi-hermes-memory:agent/projects-memory",
    "PI_SANDBOX_WORKSPACE": "/workspace",
    "PI_SANDBOX_HERDR_ENABLED": "0",
    "OMP_AUTH_BROKER_URL": "http://host.containers.internal:47311",
    "OMP_AUTH_BROKER_TOKEN": "${localEnv:OMP_AUTH_BROKER_TOKEN}",
    "UV_PROJECT_ENVIRONMENT": "/opt/venv",
    "UV_PYTHON": "3.13"
  },
  "postStartCommand": "bash /opt/pi-sandbox/lib/entrypoint.sh",
  "postAttachCommand": "echo 're-uq sandbox ready. Run: pi or omp   (this container IS the security boundary)'",
  "runArgs": [
    "--label",
    "pi-sandbox.name=re-uq",
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "initializeCommand": [
    "/Users/nicolas/.pi/devcontainer/bin/pi-sandbox",
    "workspace",
    "/Users/nicolas/re-uq"
  ]
}
