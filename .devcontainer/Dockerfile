# This file is generated by pi-sandbox from .devcontainer/sandbox.json.
# Edit sandbox.json and re-run `pi-sandbox render`; direct edits are overwritten.
#
# Sandbox image for the pi coding agent. pi ships no built-in sandbox and runs
# its tools without a per-call approval prompt, so this container IS the
# security boundary. At runtime only the workspace and the explicitly shared
# Pi memory paths are writable; all other host config arrives read-only.
FROM mcr.microsoft.com/devcontainers/base:ubuntu

# Base tooling. flock (util-linux) serializes shared-state startup,
# build-essential covers native
# wheels, tmux provides multiplexed shell sessions, and rsync/openssh-client
# back the seed import and remote submits.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        rsync openssh-client util-linux tmux build-essential ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node 22 for pi itself, then pi installed globally. The
# entrypoint refreshes pi into a staged prefix on every start, so a cached
# image never freezes the agent at build time. --ignore-scripts per pi.dev.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs \
    && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@latest \
    && pi --version \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# qmd backs pi's memory_search and session_search: pi-hermes-memory shells
# out to this binary, and without it a sandbox has no memory search at all.
# Install scripts run here, unlike pi's: qmd resolves prebuilt better-sqlite3
# and sqlite-vec natives for this architecture through them. Pinned like RTK:
# nothing refreshes qmd at runtime, so a floating tag would freeze at
# whatever the layer cache first resolved, without a pin's reproducibility.
RUN npm install -g @tobilu/qmd@2.8.3 \
    && qmd --version \
    && npm cache clean --force

# Herdr terminal workspace manager. Pin the release and verify its published
# checksums so image rebuilds are reproducible on both supported Linux arches.
# herdr.enabled controls only the host lifecycle bridge; the CLI
# itself is available in every sandbox.
ARG HERDR_VERSION=0.8.2
RUN set -eu; \
    case "$(uname -m)" in \
      aarch64) herdr_target="linux-aarch64"; herdr_sha256="f55610658e1c2e0d2aaef730b4b2ab885f7f8ba00285ab372bfb14f2e3d5b40d" ;; \
      x86_64) herdr_target="linux-x86_64"; herdr_sha256="976150a14d490c94b243ea2e1a7eb2dfb67f12e36b182db90936f6728e6aecf4" ;; \
      *) echo "unsupported Herdr architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/herdrdev/herdr/releases/download/v${HERDR_VERSION}/herdr-${herdr_target}" -o /tmp/herdr; \
    echo "${herdr_sha256}  /tmp/herdr" | sha256sum -c -; \
    install -m 0755 /tmp/herdr /usr/local/bin/herdr; \
    rm /tmp/herdr; \
    herdr --version; \
    integration_home=/tmp/pi-sandbox-herdr-integrations; \
    install -d "${integration_home}/.pi/agent/extensions" "${integration_home}/.omp/agent/extensions" /usr/local/share/pi-sandbox/herdr; \
    HOME="${integration_home}" herdr integration install pi; \
    HOME="${integration_home}" herdr integration install omp; \
    install -m 0444 "${integration_home}/.pi/agent/extensions/herdr-agent-state.ts" /usr/local/share/pi-sandbox/herdr/herdr-agent-state.ts; \
    install -m 0444 "${integration_home}/.omp/agent/extensions/herdr-omp-agent-state.ts" /usr/local/share/pi-sandbox/herdr/herdr-omp-agent-state.ts; \
    rm -rf "${integration_home}"

# OMP's plugin manager delegates npm/git installs to Bun. Install Bun with
# its required postinstall enabled, then smoke-check the executable before
# any sandbox can rely on host plugin reconciliation.
RUN npm install -g bun@latest \
    && bun --version \
    && npm cache clean --force

# Oh My Pi coding harness. The image carries the current official prebuilt
# binary for this architecture as the offline floor; the entrypoint keeps a
# writable copy in the home volume current, so a cached image cannot pin the
# harness to its build-time release.
RUN export PI_INSTALL_DIR=/usr/local/bin; \
    curl -fsSL https://omp.sh/install | sh -s -- --binary \
    && omp --version

# uv (Astral) — single static binary, multi-arch.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# The project venv lives outside /workspace, so the host's own
# .venv is never seen or used by container processes.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=3.13 \
    UV_LINK_MODE=copy
RUN mkdir -p /opt/venv && chown vscode:vscode /opt/venv

# `pi-commit` is the agent's only way to hand work back to the host. The
# script itself lives in the mounted core, so this is a thin exec wrapper:
# the image never carries a copy that could drift, and the wrapper sits in a
# root-owned PATH directory that no volume mount can make unwritable.
RUN printf '%s\n' '#!/usr/bin/env bash' \
      'exec bash /opt/pi-sandbox/lib/pi-commit "$@"' > /usr/local/bin/pi-commit \
    && chmod 0755 /usr/local/bin/pi-commit

# Staged pi runtime root. The entrypoint installs each refresh into a new
# prefix below this root and only re-points the active symlink after the
# candidate passes `pi --version`; /usr/bin/pi stays as an offline fallback.
RUN install -d -o vscode -g vscode -m 0755 \
      /opt/pi-runtime /opt/pi-runtime/bin \
    && ln -s /usr/bin/pi /opt/pi-runtime/bin/pi

USER vscode
ENV HOME=/home/vscode
ENV PATH=/opt/pi-sandbox/bin:/home/vscode/.pi/agent/bin:/opt/pi-runtime/bin:/opt/venv/bin:/home/vscode/.local/bin:$PATH

# Optionally pre-bake the Python environment into the image. Default OFF so
# the persisted /opt/venv volume stays the single environment lifecycle;
# build with --build-arg SYNC_DEPS=1 for an instant (but much larger) start.
ARG SYNC_DEPS=0
WORKDIR /home/vscode/_bootstrap
COPY --chown=vscode:vscode pyproject.toml uv.lock ./
RUN if [ "$SYNC_DEPS" = "1" ]; then uv sync --frozen --no-install-project; fi \
    && cd /home/vscode && rm -rf /home/vscode/_bootstrap

WORKDIR /workspace
CMD ["bash", "-l"]
